# Browser-safe Supabase configuration
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Gemini configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Bank sponsor (server-only). Do not set until official sandbox docs exist.
# Never use VITE_ prefixes for these secrets. Never put them in frontend code.
# Future sponsor calls must go through Netlify functions only.
# BANK_SPONSOR_MODE=demo
# BANK_CLIENT_ID=
# BANK_CLIENT_SECRET=
# BANK_WEBHOOK_SECRET=
# BANK_SANDBOX_BASE_URL=