# Server-only. Never put these in VITE_* or frontend code.
# The Vite app must not read AI secrets. Netlify: Site settings → Environment variables.
# AI is optional. Leave GEMINI_API_KEY empty to use rule-based fallback advice.

# Paste your Gemini API key here / Gemini API key ကို ဒီမှာ paste လုပ်ပါ
GEMINI_API_KEY=

# Chat / structured advice (Google Gemini generateContent).
GEMINI_TEXT_MODEL=gemini-3.7-flash

# Voice / transcribe model (server only; never expose to the client bundle).
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Legacy aliases. GEMINI_* takes precedence when set.
AI_API_KEY=
AI_MODEL=gemini-3.7-flash
AI_API_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=10000
